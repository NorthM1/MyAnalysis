<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <VideoView
        android:id="@+id/video_view_doctor"
        android:layout_width="wrap_content"
        android:layout_height="200dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.example.analysis.OverlayView
        android:id="@+id/overlay_doctor"
        android:layout_width="wrap_content"
        android:layout_height="200dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <VideoView
        android:layout_marginTop="50dp"
        android:id="@+id/video_view_patient"
        android:layout_width="wrap_content"
        android:layout_height="200dp"
        app:layout_constraintTop_toBottomOf="@id/overlay_doctor"
        app:layout_constraintStart_toStartOf="parent" />

    <com.example.analysis.OverlayView
        android:id="@+id/overlay_patient"
        android:layout_width="wrap_content"
        android:layout_height="200dp"
        app:layout_constraintTop_toTopOf="@id/video_view_patient"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btn_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="开始分析"
        app:layout_constraintTop_toBottomOf="@id/video_view_patient"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btn_load_doctor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="导入医生视频"
        app:layout_constraintTop_toBottomOf="@id/video_view_patient"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/btn_load_patient"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="导入患者视频"
        app:layout_constraintTop_toBottomOf="@id/video_view_patient"
        app:layout_constraintEnd_toEndOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>